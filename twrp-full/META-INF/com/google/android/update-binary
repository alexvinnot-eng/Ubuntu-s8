#!/sbin/sh
set -eu

OUTFD="$2"
ZIPFILE="$3"
WORKDIR="/tmp/ut-dream2lte-full-installer"
ROOTFS_TMP="/data/ubuntu.img.new"
ROOTFS_FINAL="/data/ubuntu.img"
MAX_BOOT_SIZE=41943040

ui_print() {
    echo "ui_print $*" > "/proc/self/fd/$OUTFD"
    echo "ui_print" > "/proc/self/fd/$OUTFD"
}

abort_install() {
    ui_print "ERROR: $*"
    exit 1
}

prop() {
    getprop "$1" 2>/dev/null || true
}

MODEL="$(prop ro.product.model)"
VENDOR_MODEL="$(prop ro.product.vendor.model)"
BOOTLOADER="$(prop ro.bootloader)"
DEVICE="$(prop ro.product.device)"
IDENTITY="$MODEL $VENDOR_MODEL $BOOTLOADER $DEVICE"

ui_print "Ubuntu Touch 20.04 bring-up installer v0.2.2"
ui_print "Target: Samsung Galaxy S8+ Exynos SM-G955F"
ui_print "Detected: model=$MODEL device=$DEVICE bootloader=$BOOTLOADER"

case "$IDENTITY" in
    *SM-G955F*|*G955F*) ;;
    *) abort_install "Device is not positively identified as SM-G955F; nothing was flashed." ;;
esac

BOOT_BLOCK=""
for candidate in \
    /dev/block/by-name/BOOT \
    /dev/block/bootdevice/by-name/BOOT \
    /dev/block/platform/*/by-name/BOOT
do
    if [ -b "$candidate" ]; then
        BOOT_BLOCK="$candidate"
        break
    fi
done
[ -n "$BOOT_BLOCK" ] || abort_install "BOOT partition was not found; nothing was flashed."

if ! grep -q ' /data ' /proc/mounts; then
    ui_print "Mounting userdata"
    mount /data || abort_install "Could not mount /data; nothing was flashed."
fi
[ -d /data ] && [ -w /data ] || abort_install "/data is not writable; nothing was flashed."
command -v sha256sum >/dev/null 2>&1 || abort_install "sha256sum is required by this installer."

mkdir -p "$WORKDIR"
unzip -o "$ZIPFILE" boot.img boot.img.sha256 ubuntu.img.sha256 ubuntu.img.size-kb ubuntu.img.parts -d "$WORKDIR" >/dev/null \
    || abort_install "Could not extract installer metadata; nothing was flashed."

BOOT_IMAGE="$WORKDIR/boot.img"
[ -s "$BOOT_IMAGE" ] || abort_install "boot.img is missing or empty; nothing was flashed."
BOOT_SIZE="$(wc -c < "$BOOT_IMAGE" | tr -d ' ')"
[ "$BOOT_SIZE" -le "$MAX_BOOT_SIZE" ] \
    || abort_install "boot.img exceeds the 40 MiB BOOT partition; nothing was flashed."

BOOT_EXPECTED="$(awk '{print $1}' "$WORKDIR/boot.img.sha256")"
BOOT_ACTUAL="$(sha256sum "$BOOT_IMAGE" | awk '{print $1}')"
[ "$BOOT_EXPECTED" = "$BOOT_ACTUAL" ] \
    || abort_install "boot.img checksum mismatch; nothing was flashed."

ROOTFS_EXPECTED="$(awk '{print $1}' "$WORKDIR/ubuntu.img.sha256")"
ROOTFS_KB="$(tr -d '[:space:]' < "$WORKDIR/ubuntu.img.size-kb")"
case "$ROOTFS_KB" in
    ''|*[!0-9]*) abort_install "ubuntu.img size metadata is invalid; nothing was flashed." ;;
esac
[ "$ROOTFS_KB" -gt 0 ] \
    || abort_install "ubuntu.img size metadata is invalid; nothing was flashed."
[ -s "$WORKDIR/ubuntu.img.parts" ] \
    || abort_install "ubuntu.img parts manifest is missing; nothing was flashed."

FREE_KB="$(df -k /data 2>/dev/null | tail -n 1 | awk '{print $(NF-2)}')"
case "$FREE_KB" in
    ''|*[!0-9]*) abort_install "Could not determine free space on userdata; nothing was flashed." ;;
esac
NEEDED_KB="$((ROOTFS_KB + 131072))"
[ -n "$FREE_KB" ] && [ "$FREE_KB" -ge "$NEEDED_KB" ] \
    || abort_install "At least 4 GB of free space on userdata is required."

ui_print "Installing Ubuntu Touch rootfs to /data/ubuntu.img"
rm -f "$ROOTFS_TMP"
: > "$ROOTFS_TMP"
PART_COUNT=0
while IFS= read -r PART_NAME; do
    [ -n "$PART_NAME" ] || continue
    case "$PART_NAME" in
        ubuntu.img.part[0-9][0-9]) ;;
        *) rm -f "$ROOTFS_TMP"; abort_install "Invalid ubuntu.img part name; BOOT was not changed." ;;
    esac
    ui_print "Extracting $PART_NAME"
    unzip -p "$ZIPFILE" "$PART_NAME" >> "$ROOTFS_TMP" \
        || { rm -f "$ROOTFS_TMP"; abort_install "Could not extract $PART_NAME; BOOT was not changed."; }
    PART_COUNT="$((PART_COUNT + 1))"
done < "$WORKDIR/ubuntu.img.parts"
[ "$PART_COUNT" -gt 0 ] \
    || { rm -f "$ROOTFS_TMP"; abort_install "No ubuntu.img parts were extracted; BOOT was not changed."; }

ROOTFS_ACTUAL="$(sha256sum "$ROOTFS_TMP" | awk '{print $1}')"
[ "$ROOTFS_EXPECTED" = "$ROOTFS_ACTUAL" ] \
    || { rm -f "$ROOTFS_TMP"; abort_install "ubuntu.img checksum mismatch; BOOT was not changed."; }

chmod 0600 "$ROOTFS_TMP"
chown 0:0 "$ROOTFS_TMP" 2>/dev/null || true
mv -f "$ROOTFS_TMP" "$ROOTFS_FINAL"
sync

ui_print "Flashing diagnostic boot.img to $BOOT_BLOCK"
dd if="$BOOT_IMAGE" of="$BOOT_BLOCK" bs=4096 \
    || abort_install "Writing BOOT failed. Restore the TWRP BOOT backup."
sync

ui_print "Installation completed. First boot may take several minutes."
ui_print "This is an early bring-up build, not a daily-use release."
exit 0
